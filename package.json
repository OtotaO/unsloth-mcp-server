{
  "name": "unsloth-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Unsloth - a library for optimizing and fine-tuning LLMs",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "unsloth-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OtotaO/unsloth-mcp-server.git"
  },
  "homepage": "https://github.com/OtotaO/unsloth-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/OtotaO/unsloth-mcp-server/issues"
  },
  "mcpName": "io.github.OtotaO/unsloth-mcp-server",
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "ts-node src/index.ts",
    "prepack": "npm run build",
    "check:pack": "node scripts/check-pack.mjs",
    "prepare": "lefthook install"
  },
  "keywords": [
    "unsloth",
    "llm",
    "fine-tuning",
    "mcp",
    "ai"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "lefthook": "^2.1.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
